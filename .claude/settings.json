{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(go mod download:*)",
      "Bash(go mod vendor)",
      "Bash(gofmt:*)",
      "Bash(govulncheck:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(scripts/check-hygiene.sh)",
      "Bash(git push:*)",
      "Bash(ssh phobos@192.168.1.221 ~/gate.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v gofmt >/dev/null 2>&1 || exit 0; printf '%s' \"$CLAUDE_FILE_PATHS\" | tr ' ' '\\n' | while IFS= read -r f; do case \"$f\" in *.go) [ -f \"$f\" ] && gofmt -w \"$f\" ;; esac; done; exit 0"
          }
        ]
      }
    ]
  }
}
